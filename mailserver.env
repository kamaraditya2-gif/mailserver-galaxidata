# ============================================================
# Docker Mailserver — GALAXIDATA.COM ONLY
# ============================================================

OVERRIDE_HOSTNAME=mail.galaxidata.com
POSTMASTER_ADDRESS=postmaster@galaxidata.com
DMS_DEBUG=0
ONE_DIR=1

SSL_TYPE=manual
SSL_CERT_PATH=/tmp/docker-mailserver/ssl/cert.pem
SSL_KEY_PATH=/tmp/docker-mailserver/ssl/key.pem

ENABLE_RSPAMD=1
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_SPAMASSASSIN=0

SMTP_ONLY=0
